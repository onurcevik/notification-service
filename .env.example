# Copy to .env and adjust. With Docker Compose, DB/Redis host names match service names.
# Set WEBHOOK_URL to your webhook.site URL to see notifications delivered.

# -----------------------------------------------------------------------------
# Database (must match postgres service in docker-compose)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=notifications
DB_USER=postgres
DB_PASSWORD=secret
# DB_SSL_MODE=disable   # or DB_SSLMODE=disable; default: disable

# -----------------------------------------------------------------------------
# Redis (must match redis service in docker-compose)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=       # optional; leave unset for no auth

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8080

# -----------------------------------------------------------------------------
# Webhook (test delivery)
# Create a URL at https://webhook.site and paste it here. Notifications will
# queue but delivery will fail until this is set to a valid endpoint.
# -----------------------------------------------------------------------------
WEBHOOK_URL=https://webhook.site/your-uuid-here

# -----------------------------------------------------------------------------
# Worker & queue
# -----------------------------------------------------------------------------
# WORKER_COUNT_PER_CHANNEL=10   # workers per channel (email, sms, push)
# RATE_LIMIT_PER_SEC=100        # max deliveries per channel per second
# MAX_RETRY_ATTEMPTS=4          # delivery attempts before dead-letter
# OUTBOX_POLL_INTERVAL_MS=100   # outbox relay poll interval (ms)
# SCHEDULER_INTERVAL_SEC=5      # how often to fetch due scheduled notifications (sec)
# QUEUE_CONSUME_BLOCK_MS=100   # Redis XREADGROUP block time per stream (ms)

# -----------------------------------------------------------------------------
# Circuit breaker (per-channel provider protection)
# -----------------------------------------------------------------------------
# CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=5   # failures before opening circuit
# CIRCUIT_BREAKER_TIMEOUT_SEC=30          # seconds before half-open
# CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=1 # probes in half-open state
