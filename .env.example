# Copy to .env and adjust. With Docker Compose, these defaults work out of the box;
# set WEBHOOK_URL to your webhook.site URL to see notifications delivered.

# Database (must match postgres service in docker-compose)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=notifications
DB_USER=postgres
DB_PASSWORD=secret

# Redis (must match redis service in docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379

# Server
PORT=8080

# Webhook: create a URL at https://webhook.site and paste it here to test delivery.
# Leave as-is to run the API; notifications will queue but delivery will fail until set.
WEBHOOK_URL=https://webhook.site/your-uuid-here
